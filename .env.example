# Backend API URL (without trailing slash, e.g. https://your-backend.onrender.com/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Real-time Socket.IO URL (e.g. https://your-backend.onrender.com)
VITE_SOCKET_URL=http://localhost:5000

# Stripe Publishable Key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_MockPublishableKeyForDevelopmentMode000000000
